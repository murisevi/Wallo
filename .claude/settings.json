{
  "permissions": {
    "allow": [
      "Bash(cd backend && ruff:*)",
      "Bash(cd backend && pytest:*)",
      "Bash(cd backend && mypy:*)",
      "Bash(cd backend && alembic:*)",
      "Bash(cd frontend && npm:*)",
      "Bash(docker compose:*)",
      "Bash(make:*)",
      "Bash(pip install:*)",
      "Bash(pip list:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Write(.env)",
      "Bash(rm -rf /)*"
    ]
  }
}
