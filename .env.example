# =============================================================================
# Wallo — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# NEVER commit the .env file — it is gitignored.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. When running via Docker Compose the hostname
# is the service name ("db"), not "localhost".
DATABASE_URL=postgresql+asyncpg://wallo:wallo@localhost:5432/wallo

# ── Authentication ───────────────────────────────────────────────────────────
# Secret used to sign JWT access tokens. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Enable Banking (PSD2 Open Banking) ──────────────────────────────────────
# 1. Register an application at https://enablebanking.com/cp/applications
# 2. Copy the Application ID here.
# 3. Save the generated .pem private key to Backend/keys/ (the directory is
#    gitignored — never commit .pem files).
ENABLE_BANKING_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
ENABLE_BANKING_PRIVATE_KEY_PATH=keys/private.pem
# "sandbox" for testing with Mock ASPSP / BBVA sandbox, "production" for live.
ENABLE_BANKING_ENVIRONMENT=sandbox
# Must exactly match the URL whitelisted in the Enable Banking control panel.
ENABLE_BANKING_REDIRECT_URL=http://localhost:3000/banking/callback

# ── Frontend ─────────────────────────────────────────────────────────────────
# Base URL the Next.js frontend uses to reach the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Redis (optional for MVP) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
