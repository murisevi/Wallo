# Wallo environment template
# Copy this file to .env and replace placeholder values before running the app.

# Database
# Docker Compose overrides this for the backend container, but this value is useful
# for running the backend locally from Backend/.
DATABASE_URL=postgresql+asyncpg://wallo:wallo@localhost:5432/wallo

# Auth
# Replace with a strong random value in any non-demo environment.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Enable Banking
# Create these values in the Enable Banking control panel.
ENABLE_BANKING_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
ENABLE_BANKING_PRIVATE_KEY_PATH=keys/private.pem
ENABLE_BANKING_ENVIRONMENT=sandbox
ENABLE_BANKING_REDIRECT_URL=https://localhost:3000/banking/callback

# Frontend / CORS
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# Redis
# Docker Compose overrides this for the backend container.
REDIS_URL=redis://localhost:6379/0
